{
  "name": "file-reader-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to read the contents of a file",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "check": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andstor/file-reader-action.git"
  },
  "keywords": [
    "actions",
    "file",
    "reader"
  ],
  "author": {
    "name": "André Storhaug",
    "email": "andr3.storhaug@gmail.com",
    "url": "https://github.com/andstor"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andstor/file-reader-action/issues"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "rollup": "^4.63.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}